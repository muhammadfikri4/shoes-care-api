generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  ADMIN
  CUSTOMER
}

enum RackStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

enum TransactionStatus {
  CREATED
  IN_PROGRESS
  READY_TO_PICKUP
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  QRIS
  CASH
  TRANSFER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

model User {
  id       String  @id @default(uuid())
  name     String
  email    String
  password String?
  role     Role    @default(CUSTOMER)
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // relation
  transactions       Transaction[]
  TransactionHistory TransactionHistory[]
  Customer           Customer?
  Promo              Promo[]
  Otp                Otp[]

  @@unique([email, role])
  @@map("users")
}

model Rack {
  id       String     @id @default(uuid())
  code     String     @unique
  name     String?
  location String?
  status   RackStatus @default(AVAILABLE)

  // relation

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  TransactionItem TransactionItem[]

  @@map("racks")
}

model Transaction {
  id         String            @id @default(uuid())
  code       String            @unique
  userId     String?           @map("user_id")
  customerId String?           @map("customer_id")
  status     TransactionStatus @default(CREATED)

  price        Int // base price
  finalPrice   Int     @map("final_price") // setelah diskon/promo
  promoApplied Boolean @default(false) @map("promo_applied")

  // Payment & customer snapshot
  paymentMethod       PaymentMethod? @map("payment_method")
  paymentStatus       PaymentStatus  @default(PENDING) @map("payment_status")
  paidAt              DateTime?      @map("paid_at")
  cashPaid            Int?           @map("cash_paid")
  cashChange          Int?           @map("cash_change")
  midtransToken       String?        @map("midtrans_token")
  midtransRedirectUrl String?        @map("midtrans_redirect_url")

  // QR & Pickup
  qrCodeData String @unique @map("qr_code_data")

  // Timestamps status penting (opsional tapi berguna untuk audit/riwayat)
  inProgressAt DateTime? @map("in_progress_at")
  readyAt      DateTime? @map("ready_at")
  pickedUpAt   DateTime? @map("picked_up_at")
  cancelledAt  DateTime? @map("cancelled_at")

  // Snapshot data customer (agar histori tetap, walau user update profil)
  customerName  String? @map("customer_name")
  customerEmail String? @map("customer_email")
  customerPhone String? @map("customer_phone")

  // Relation
  customer        User?             @relation(fields: [userId], references: [id])
  customerProfile Customer?         @relation(fields: [customerId], references: [id])
  items           TransactionItem[]

  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  TransactionHistory TransactionHistory[]

  @@index([status])
  @@index([userId])
  @@index([customerId])
  @@map("transactions")
}

model TransactionItem {
  id            String  @id @default(uuid())
  transactionId String  @map("transaction_id")
  name          String
  price         Int // harga satuan
  estimateDay   Int?    @map("estimateDay")
  file          String
  note          String?
  rackId        String  @map("rack_id")

  transaction Transaction @relation(fields: [transactionId], references: [id])
  rack        Rack        @relation(fields: [rackId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([transactionId])
  @@index([rackId])
  @@map("transaction_items")
}

model TransactionHistory {
  id            String             @id @default(uuid())
  transactionId String             @map("transaction_id")
  fromStatus    TransactionStatus? @map("previous_status")
  toStatus      TransactionStatus  @map("new_status")

  note        String?
  metadata    Json?
  actorUserId String?  @map("actor_user_id")
  actorRole   Role?    @map("actor_role")
  changedAt   DateTime @default(now()) @map("changed_at")

  transaction Transaction @relation(fields: [transactionId], references: [id])
  actor       User?       @relation(fields: [actorUserId], references: [id])

  @@index([transactionId])
  @@index([fromStatus, changedAt])
  @@map("transaction_histories")
}

model Customer {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")

  // optional extended profile
  name                String?
  activatedAt         DateTime? @map("activated_at")
  activationCode      String?   @map("activation_code")
  activationExpiresAt DateTime? @map("activation_expires_at")

  // relations
  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("customers")
}

model Promo {
  id              String    @id @default(uuid())
  code            String    @unique
  userId          String    @map("user_id")
  discountPercent Int       @default(100) @map("discount_percent")
  isActive        Boolean   @default(true) @map("is_active")
  used            Boolean   @default(false)
  usedAt          DateTime? @map("used_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("promos")
}

model Otp {
  id             String    @id @default(uuid())
  email          String
  userId         String?
  purpose        String
  code           String
  hashedPassword String?
  expiresAt      DateTime  @map("expires_at")
  usedAt         DateTime? @map("used_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([email])
  @@index([userId])
  @@index([purpose])
  @@map("otps")
}
