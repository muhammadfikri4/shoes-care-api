generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  ADMIN
  CUSTOMER
}

enum TransactionStatus {
  CREATED
  IN_PROGRESS
  READY_TO_PICKUP
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  QRIS
  CASH
  TRANSFER
}

model User {
  id       String  @id @default(uuid()) @db.Char(36)
  name     String  @db.VarChar(64)
  email    String  @db.VarChar(64)
  password String? @db.VarChar(255)
  role     Role    @default(CUSTOMER)
  isActive Boolean @default(true) @map("is_active")

  resetPasswordToken          String?   @map("reset_password_token") @db.VarChar(255)
  resetPasswordTokenExpiredAt DateTime? @map("reset_password_token_expired_at")

  promoEligibilityCount Int @default(0) @map("promo_eligibility_count")
  totalPromosReceived   Int @default(0) @map("total_promos_received")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  transactionsCreated    Transaction[]        @relation("CreatedByUser")
  transactionsAsCustomer Transaction[]        @relation("CustomerUser")
  TransactionHistory     TransactionHistory[]
  Promo                  Promo[]

  @@unique([email, role])
  @@map("users")
}

model Rack {
  id          String  @id @default(uuid())
  code        String  @unique @db.VarChar(10)
  name        String? @db.VarChar(64)
  description String? @db.Text

  // relation

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  TransactionItem TransactionItem[]

  @@map("racks")
}

model Transaction {
  id              String            @id @default(uuid()) @db.Char(36)
  code            String            @unique @db.VarChar(32)
  createdByUserId String?           @map("created_by_user_id") @db.Char(36)
  customerUserId  String?           @map("customer_user_id") @db.Char(36)
  status          TransactionStatus @default(CREATED)

  price        Int // base price
  finalPrice   Int     @map("final_price") // setelah diskon/promo
  promoApplied Boolean @default(false) @map("promo_applied")
  promoId      String? @map("promo_id") @db.Char(36)

  // Payment & customer snapshot
  paymentMethod       PaymentMethod? @map("payment_method")
  paidAt              DateTime?      @map("paid_at")
  cashPaid            Int?           @map("cash_paid")
  cashChange          Int?           @map("cash_change")
  midtransToken       String?        @map("midtrans_token") @db.VarChar(255)
  midtransRedirectUrl String?        @map("midtrans_redirect_url") @db.VarChar(512)

  qrCodeData String  @unique @map("qr_code_data") @db.VarChar(128)
  qrCodeUrl  String? @map("qr_code_url") @db.VarChar(512)

  inProgressAt DateTime? @map("in_progress_at")
  readyAt      DateTime? @map("ready_at")
  pickedUpAt   DateTime? @map("picked_up_at")
  cancelledAt  DateTime? @map("cancelled_at")

  customerName  String? @map("customer_name") @db.VarChar(64)
  customerEmail String? @map("customer_email") @db.VarChar(64)
  customerPhone String? @map("customer_phone") @db.VarChar(16)

  createdByUser User?             @relation("CreatedByUser", fields: [createdByUserId], references: [id])
  customerUser  User?             @relation("CustomerUser", fields: [customerUserId], references: [id])
  promo         Promo?            @relation(fields: [promoId], references: [id])
  items         TransactionItem[]

  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  TransactionHistory TransactionHistory[]

  @@index([status])
  @@index([createdByUserId])
  @@index([customerUserId])
  @@index([promoId])
  @@map("transactions")
}

model TransactionItem {
  id            String  @id @default(uuid())
  transactionId String  @map("transaction_id") @db.Char(36)
  name          String  @db.VarChar(64)
  price         Int // harga satuan
  estimateDay   Int?    @map("estimateDay")
  file          String  @db.VarChar(128)
  note          String? @db.Text
  rackId        String  @map("rack_id") @db.Char(36)

  transaction Transaction @relation(fields: [transactionId], references: [id])
  rack        Rack        @relation(fields: [rackId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([transactionId])
  @@index([rackId])
  @@map("transaction_items")
}

model TransactionHistory {
  id            String             @id @default(uuid()) @db.Char(36)
  transactionId String             @map("transaction_id") @db.Char(36)
  fromStatus    TransactionStatus? @map("previous_status")
  toStatus      TransactionStatus  @map("new_status")

  note        String?  @db.Text
  metadata    Json?
  actorUserId String?  @map("actor_user_id")
  actorRole   Role?    @map("actor_role")
  changedAt   DateTime @default(now()) @map("changed_at")

  transaction Transaction @relation(fields: [transactionId], references: [id])
  actor       User?       @relation(fields: [actorUserId], references: [id])

  @@index([transactionId])
  @@index([fromStatus, changedAt])
  @@map("transaction_histories")
}

model Promo {
  id              String    @id @default(uuid()) @db.Char(36)
  code            String    @unique @db.VarChar(32)
  userId          String    @map("user_id") @db.Char(36)
  discountPercent Int       @default(100) @map("discount_percent")
  isActive        Boolean   @default(true) @map("is_active")
  isUsed          Boolean   @default(false) @map("is_used")
  usedAt          DateTime? @map("used_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]

  @@map("promos")
}

model PromoConfiguration {
  id                   String   @id @default(uuid()) @db.Char(36)
  requiredTransactions Int      @default(10) @map("required_transactions")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("promo_configurations")
}
